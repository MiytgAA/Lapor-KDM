# =============================================
# LAPOR KDM — Backend API Environment Config
# =============================================
# Salin file ini menjadi .env dan isi nilainya

# ─── SERVER ───────────────────────────────
PORT=5000
NODE_ENV=development

# ─── DATABASE (MySQL) ─────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=lapor_kdm

# ─── JWT ──────────────────────────────────
JWT_SECRET=lapor_kdm_super_secret_jwt_key_2026
JWT_REFRESH_SECRET=lapor_kdm_refresh_secret_key_2026
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ─── FILE UPLOAD ──────────────────────────
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880
# 5MB = 5 * 1024 * 1024 = 5242880

# ─── CORS ─────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── RATE LIMIT ───────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
